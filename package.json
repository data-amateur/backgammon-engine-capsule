{
  "name": "@rollbg/engine-capsule",
  "version": "0.1.0",
  "private": true,
  "description": "A separately hosted BEP v1 browser engine capsule for RollBG",
  "license": "SEE LICENSE IN NOTICE.md",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build:worker": "node scripts/build-worker.mjs development && node scripts/verify-worker.mjs",
    "build:worker:production": "node scripts/build-worker.mjs production && node scripts/verify-worker.mjs",
    "build:worker:verification": "node scripts/build-worker.mjs verification && node scripts/verify-worker.mjs",
    "dev": "npm run build:gnubg-wasm && npm run stage:browser && npm run build:worker && vite --host 127.0.0.1 --port 4174 --strictPort",
    "build": "tsc -b && npm run build:gnubg-wasm:production && npm run stage:browser:production && npm run build:worker:production && vite build && npm run verify:dist",
    "build:verification": "tsc -b && npm run build:gnubg-wasm:verification && npm run stage:browser:verification && npm run build:worker:verification && vite build --mode verification && npm run verify:dist",
    "preview": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "preview:verification": "vite preview --mode verification --host 127.0.0.1 --port 4174 --strictPort",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify:dist": "node scripts/verify-dist.mjs",
    "verify:gnubg-source": "node scripts/verify-gnubg-source.mjs",
    "generate:gnubg-met": "node scripts/generate-gnubg-met.mjs",
    "test:gnubg-met-generator": "node scripts/test-generate-gnubg-met.mjs",
    "verify": "npm run verify:gnubg-source && npm run test:gnubg-met-generator && npm run test:source-bundle && npm run typecheck && npm run lint && npm run test && npm run test:wasm-abi-layout && npm run test:gnubg-native",
    "prepare:gnubg-source": "node scripts/prepare-gnubg-source.mjs",
    "build:gnubg-native": "node scripts/build-gnubg-native.mjs",
    "test:gnubg-native": "node scripts/test-gnubg-native.mjs",
    "test:wasm-abi-layout": "node scripts/test-wasm-abi-layout.mjs",
    "build:wasm-abi": "node scripts/build-wasm-abi.mjs",
    "test:wasm-abi": "npm run build:wasm-abi && node scripts/test-wasm-abi.mjs",
    "build:source": "node scripts/build-source-bundle.mjs development && node scripts/verify-source-bundle.mjs",
    "build:source:production": "node scripts/build-source-bundle.mjs production && node scripts/verify-source-bundle.mjs --require-clean",
    "build:source:verification": "node scripts/build-source-bundle.mjs verification && node scripts/verify-source-bundle.mjs",
    "test:source-bundle": "node scripts/test-source-bundle.mjs",
    "build:gnubg-wasm:raw": "node scripts/build-gnubg-wasm.mjs",
    "build:gnubg-wasm": "npm run build:source && npm run build:gnubg-wasm:raw",
    "build:gnubg-wasm:production": "npm run build:source:production && npm run build:gnubg-wasm:raw",
    "build:gnubg-wasm:verification": "npm run build:source:verification && npm run build:gnubg-wasm:raw",
    "test:gnubg-wasm": "npm run build:gnubg-wasm && node scripts/test-gnubg-wasm.mjs",
    "test:gnubg-native:sanitized": "node scripts/test-gnubg-native.mjs --sanitized",
    "test:wasm-abi-layout:sanitized": "node scripts/test-wasm-abi-layout.mjs --sanitized",
    "stage:browser": "node scripts/stage-gnubg-browser-assets.mjs development",
    "stage:browser:production": "node scripts/stage-gnubg-browser-assets.mjs production",
    "stage:browser:verification": "node scripts/stage-gnubg-browser-assets.mjs verification",
    "verify:browser": "npm run build:verification"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.5",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
