{
  "name": "@backgammon-light/engine-capsule",
  "version": "0.1.0",
  "private": true,
  "description": "A separately hosted BEP v1 browser engine capsule for Backgammon Light",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build:worker": "node scripts/build-worker.mjs development && node scripts/verify-worker.mjs",
    "build:worker:production": "node scripts/build-worker.mjs production && node scripts/verify-worker.mjs",
    "build:worker:verification": "node scripts/build-worker.mjs verification && node scripts/verify-worker.mjs",
    "dev": "npm run build:worker && vite --host 127.0.0.1 --port 4174 --strictPort",
    "build": "tsc -b && npm run build:worker:production && vite build",
    "build:verification": "tsc -b && npm run build:worker:verification && vite build --mode verification",
    "preview": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "preview:verification": "vite preview --mode verification --host 127.0.0.1 --port 4174 --strictPort",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build:verification"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.5",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
